# ═══════════════════════════════════════════════════════════════════
# SmartHire-Agent 环境变量配置
# 复制此文件为 .env 并填入实际值
# ═══════════════════════════════════════════════════════════════════

# ── LLM (必填) ────────────────────────────────────────────────────
# 支持任何 OpenAI 兼容接口：DeepSeek / Qwen / GPT / 本地 Ollama
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── Twilio 语音通话 (可选 — 不配则跳过电话预筛选) ──────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── 飞书日历 (可选 — 不配则跳过日历集成) ──────────────────────────
# 飞书开放平台 → 创建应用 → 获取凭证 → 启用日历权限
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_ID=             # 面试官的飞书用户 ID

# ── QQ 邮箱 SMTP (可选 — 不配则跳过邮件发送) ──────────────────────
# QQ 邮箱 → 设置 → 账户 → POP3/SMTP 服务 → 开启 → 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=your_email@qq.com
SMTP_AUTH_CODE=your_auth_code_here
HR_EMAIL=hr@yourcompany.com

# ── 应用配置 ──────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
ENV=development

# ── 数据库 ────────────────────────────────────────────────────────
DB_PATH=data/smarthire.db
